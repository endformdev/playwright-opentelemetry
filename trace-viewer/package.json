{
	"name": "@playwright-opentelemetry/trace-viewer",
	"version": "0.18.0",
	"type": "module",
	"description": "Playwright OpenTelemetry Trace Viewer - A web application for viewing Playwright Opentelemetry test traces",
	"bin": "./bin/serve.js",
	"files": [
		"bin",
		"dist",
		"lib"
	],
	"exports": {
		"./components": {
			"types": "./lib/types/components.d.ts",
			"default": "./lib/components.js"
		},
		"./components.css": "./lib/components.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build && vite build --config vite.components.config.ts && tsc -p tsconfig.components.json",
		"preview": "vite preview",
		"test:e2e": "playwright test",
		"deploy": "wrangler deploy"
	},
	"keywords": [
		"playwright",
		"opentelemetry",
		"trace-viewer",
		"solidjs"
	],
	"author": "Oliver Stenbom <oliver@endform.dev>",
	"license": "Apache-2.0",
	"homepage": "https://github.com/endformdev/playwright-opentelemetry#readme",
	"bugs": {
		"url": "https://github.com/endformdev/playwright-opentelemetry/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/endformdev/playwright-opentelemetry.git",
		"directory": "trace-viewer"
	},
	"peerDependencies": {
		"solid-js": "^1.9.0"
	},
	"peerDependenciesMeta": {
		"solid-js": {
			"optional": true
		}
	},
	"devDependencies": {
		"@ark-ui/solid": "^5.37.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@leeoniya/ufuzzy": "^1.0.19",
		"@playwright-opentelemetry/trace-api": "workspace:*",
		"@playwright/test": "catalog:",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "catalog:",
		"@zip.js/zip.js": "catalog:",
		"h3": "catalog:",
		"lucide-solid": "^1.17.0",
		"solid-js": "^1.9.13",
		"tailwindcss": "^4.3.0",
		"tsx": "catalog:",
		"valibot": "^1.4.1",
		"vite": "^8.0.14",
		"vite-plugin-pwa": "^1.3.0",
		"vite-plugin-solid": "^2.11.12",
		"vitest": "catalog:",
		"workbox-build": "^7.4.1",
		"workbox-window": "^7.4.1",
		"wrangler": "^4.95.0"
	}
}
